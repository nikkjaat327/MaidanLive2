# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB (optional in local/sandbox dev; falls back to persistent local MongoDB)
MONGODB_URI=""

# JWT_SECRET: Secret key for signing authentication tokens (keep server-side only)
JWT_SECRET=""

# ADMIN_SETUP_KEY: Optional secret key required during first-time Super Admin bootstrap
ADMIN_SETUP_KEY=""
